# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
**/__pycache__/

# Virtual Environments
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/
**/env/
**/ENV/

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/

# Environment Variables & Secrets
.env
.env.local
.env.*
!.env.example
**/.env
**/.env.local
**/.env.*
!**/.env.example

# SQLite & Local Databases
*.db
*.sqlite3
**/*.db
**/*.sqlite3
data/review_audit.db
**/data/review_audit.db

# Uploads directory (ignore uploaded files, keep directory structure)
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# Logs and runtime files
*.log
**/*.log
*.pid
**/*.pid

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
**/.vscode/
**/.idea/
.project
.pydevproject
.settings/

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
