# Environment Configuration Example
# Copy this file to .env and customize for your local setup

# Application Settings
APP_ENV=development
APP_PORT=8501
DEBUG=True

# Data & Storage Paths
DATABASE_PATH=data/processed/gem_bid_compliance.db
UPLOAD_DIR=uploads/
MODEL_DIR=models/

# Future External Integrations (Placeholders - No real credentials)
GEM_PORTAL_API_BASE_URL=https://api.example.gem.gov.in/v1
GEM_PORTAL_API_KEY=your_gem_api_key_here
LLM_SERVICE_API_KEY=your_llm_api_key_here
